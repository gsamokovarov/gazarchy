# Inherit the Omarchy base ghostty config, then layer the gazarchy overrides
# on top. Ghostty loads config-file includes after this file in order, so the
# overrides win over the base. The base's own nested include (the current
# theme colors) queues after both, letting the active theme paint last.
config-file = /usr/share/omarchy/config/ghostty/config
config-file = gazarchy.conf
