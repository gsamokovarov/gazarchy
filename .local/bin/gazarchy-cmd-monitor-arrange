#!/bin/bash
#
# Apply monitor positions and persist them to ~/.config/hypr/monitors.lua.
# Used by the genadi.monitor shell panel's ARRANGEMENT section.
#
# Usage: gazarchy-cmd-monitor-arrange <name>@<XxY> [<name>@<XxY> ...]
# Example: gazarchy-cmd-monitor-arrange eDP-1@0x900 DP-1@960x0

MONITORS_LUA="$HOME/.config/hypr/monitors.lua"

monitors_json=$(hyprctl monitors -j) || exit 1

for spec in "$@"; do
  name="${spec%%@*}"
  pos="${spec#*@}"
  [[ $name && $pos =~ ^-?[0-9]+x-?[0-9]+$ ]] || continue

  info=$(jq -ce --arg n "$name" '.[] | select(.name == $n)' <<<"$monitors_json") || continue
  mode=$(jq -r '"\(.width)x\(.height)@\(.refreshRate | round)"' <<<"$info")
  scale=$(jq -r '.scale' <<<"$info")

  hyprctl keyword monitor "$name,$mode,$pos,$scale" >/dev/null

  # Persist into the monitor's rule when it pins a quoted position. Writing the
  # file makes Hyprland reload the config, which re-applies these same values.
  if [[ -f $MONITORS_LUA ]]; then
    sed -i -E "s|(hl\.monitor\(\{[^}]*output = \"$name\"[^}]*position = \")[^\"]*(\")|\1$pos\2|" "$MONITORS_LUA"
  fi
done
